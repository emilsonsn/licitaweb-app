import {Component, Inject, OnInit} from '@angular/core';
import {FormArray, FormBuilder, FormControl, FormGroup, Validators} from '@angular/forms';
import {MAT_DIALOG_DATA, MatDialogRef} from '@angular/material/dialog';
import {Observable} from 'rxjs';
import {debounceTime, distinctUntilChanged, startWith, switchMap} from 'rxjs/operators';
import {ProductService} from '@services/product.service';
import {CommitmentNotesService} from '@services/commitment-notes.service';
import {ContractService} from '@services/contract.service';
import {StatusService} from '@services/status.service';
import {CommitmentNote, CommitmentNoteProduct} from '@models/CommitmentNote';
import {IStatus} from '@models/status';
import {minLengthArray} from "@shared/helpers/minLengthArray";
import dayjs from "dayjs";

@Component({
  selector: 'app-dialog-commitment-notes',
  templateUrl: './dialog-commitment-notes.component.html',
  styleUrls: ['./dialog-commitment-notes.component.scss']
})
export class DialogCommitmentNotesComponent implements OnInit {
  notesForm: FormGroup;
  title: string = 'Cadastro de Nota de Empenho';
  isNew: boolean = true;
  loading: boolean = false;

  // Produtos
  productList: any[] = [];
  filteredProducts$: Observable<any[]>;
  productFilterCtrl: FormControl = new FormControl('');

  // Contratos
  contractList: any[] = [];
  filteredContracts$: Observable<any[]>;
  contractFilterCtrl: FormControl = new FormControl('');

  // Status
  statusList: IStatus[] = [];
  filteredStatus$: Observable<IStatus[]>;
  statusFilterCtrl: FormControl = new FormControl('');

  constructor(
    private fb: FormBuilder,
    public dialogRef: MatDialogRef<DialogCommitmentNotesComponent>,
    @Inject(MAT_DIALOG_DATA) public data: any,
    private readonly _productService: ProductService,
    private readonly _contractService: ContractService,
    private readonly _commitmentNotesService: CommitmentNotesService,
    private readonly _statusService: StatusService
  ) {
    this.notesForm = this.fb.group({
      noteNumber: ['', Validators.required],
      receivedDate: ['', Validators.required],
      deliveryDeadline: ['', Validators.required],
      contract_id: [null, Validators.required],
      products: this.fb.array([], minLengthArray(1)), // Validador para garantir 1 ou mais produtos
      status: [null, Validators.required],
      observations: ['']
    });
  }

  // Getter para facilitar o uso do FormControl de contrato
  get contractCtrl(): FormControl {
    return this.notesForm.get('contract_id') as FormControl;
  }

  // Getter para acessar o FormArray de produtos
  get products(): FormArray {
    return this.notesForm.get('products') as FormArray;
  }

  ngOnInit(): void {
    // Carrega produtos e prepara filtro
    this.loadProducts('');
    this.filteredProducts$ = this.productFilterCtrl.valueChanges.pipe(
      startWith(''),
      debounceTime(500),
      distinctUntilChanged(),
      switchMap(searchTerm => this.loadProducts(searchTerm))
    );

    // Carrega contratos e prepara filtro
    this.loadContracts('');
    this.filteredContracts$ = this.contractFilterCtrl.valueChanges.pipe(
      startWith(''),
      debounceTime(500),
      distinctUntilChanged(),
      switchMap(searchTerm => this.loadContracts(searchTerm))
    );

    // Carrega status e prepara filtro
    this.loadStatus('');
    this.filteredStatus$ = this.statusFilterCtrl.valueChanges.pipe(
      startWith(''),
      debounceTime(500),
      distinctUntilChanged(),
      switchMap(searchTerm => this.loadStatus(searchTerm))
    );
  }

  private loadProducts(searchTerm: string): Observable<any[]> {
    return this._productService.getProducts({search_term: searchTerm}).pipe(
      switchMap(res => {
        this.productList = res.data;
        return [this.productList];
      })
    );
  }

  private loadContracts(searchTerm: string): Observable<any[]> {
    return this._contractService.searchContracts(null, {search_term: searchTerm}).pipe(
      switchMap(res => {
        this.contractList = res.data;
        return [this.contractList];
      })
    );
  }

  private loadStatus(searchTerm: string): Observable<IStatus[]> {
    return this._statusService.search(searchTerm).pipe(
      switchMap((res: any) => {
        this.statusList = res.data;
        return [this.statusList];
      })
    );
  }

  addProduct(): void {
    const productForm = this.fb.group({
      productName: ['', Validators.required],
      quantity: [1, [Validators.required, Validators.min(1)]],
      sale_price: [0, [Validators.required, Validators.min(0.01)]],
      adjustedPrice: [0, [Validators.required, Validators.min(0.01)]],
      total: [0]
    });
    this.products.push(productForm);
  }

  removeProduct(index: number): void {
    this.products.removeAt(index);
  }

  submit(): void {
    if (this.notesForm.valid) {

      console.log(this.notesForm.value);

      const products: CommitmentNoteProduct[] = this.notesForm.value.products.map((product: any) => ({
        product_id: product.productName.id,
        quantity: product.quantity,
      }));


      const commitmentNotes: CommitmentNote = {
        number: this.notesForm.value.noteNumber,
        products: products,
        contract_id: this.notesForm.value.contract_id,
        status_id: this.notesForm.value.status, // Usa o id do status selecionado
        receipt_date: dayjs(this.notesForm.value.receivedDate).format('YYYY-MM-DD'),
        purchase_term: dayjs(this.notesForm.value.deliveryDeadline).format('YYYY-MM-DD')
      };


      this._commitmentNotesService.create(commitmentNotes).subscribe({
        next: (res: any) => {
          console.log(res);
        },
        error: (err: any) => {
          console.error(err);
        }
      });

      this.dialogRef.close(this.notesForm.value);
    }
  }

  close(): void {
    this.dialogRef.close();
  }

  incrementQuantity(index: number): void {
    const product = this.products.at(index);
    const currentQuantity = parseInt(product.get('quantity')?.value) || 1;
    product.patchValue({quantity: currentQuantity + 1});
    this.updateTotal(index);
  }

  decrementQuantity(index: number): void {
    const product = this.products.at(index);
    const currentQuantity = parseInt(product.get('quantity')?.value) || 1;
    if (currentQuantity > 1) {
      product.patchValue({quantity: currentQuantity - 1});
      this.updateTotal(index);
    }
  }

  onProductChange(event: any, index: number): void {
    const selectedProduct = this.productList.find(prod => prod.id === event.value.id);
    if (selectedProduct) {
      const sale_price = parseFloat(selectedProduct.sale_price) || 0;
      this.products.at(index).patchValue({
        sale_price: sale_price.toFixed(2),
        adjustedPrice: sale_price.toFixed(2)
      });
      this.updateTotal(index);
    }
  }

  validateAdjustedPrice(index: number): void {
    const product = this.products.at(index);
    if (!product) return;
    const sale_price = parseFloat(product.get('sale_price')?.value) || 0;
    const rawPrice = product.get('adjustedPrice')?.value || '';
    const cleanedPrice = rawPrice.replace(/[^\d,.-]/g, '').replace(',', '.');
    const adjustedPrice = parseFloat(cleanedPrice) || 0;
    this.updateTotal(index);
  }

  updateTotal(index: number): void {
    const product = this.products.at(index);
    if (!product) return;
    const quantity = parseFloat(product.get('quantity')?.value) || 1;
    const rawPrice = product.get('adjustedPrice')?.value || '';
    const cleanedPrice = rawPrice.replace(/[^\d,.-]/g, '').replace(',', '.');
    const adjustedPrice = parseFloat(cleanedPrice) || 0;
    product.patchValue({total: (quantity * adjustedPrice).toFixed(2)});
  }

  getTotal(index: number): string {
    const product = this.products.at(index);
    return (parseFloat(product?.get('total')?.value) || 0).toFixed(2);
  }

  toNumber(value: string | number): number {
    return typeof value === 'number'
      ? value
      : (value ? parseFloat(value.replace(/[R$\s]/g, '')) : 0);
  }

  // Função para comparação dos contratos (usada no [compareWith])
  compareContracts(a: any, b: any): boolean {
    return a === b;
  }

  // Função para comparação dos status (usada no [compareWith])
  compareStatus(a: any, b: any): boolean {
    return a === b;
  }
}
