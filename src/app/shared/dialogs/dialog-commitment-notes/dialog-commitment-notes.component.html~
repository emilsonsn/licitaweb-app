<mat-dialog-content>

  <div class="d-flex align-items-center justify-content-between">
    <span class="fw-bold fs-5">{{title}}</span>
    <div matRipple class="close" (click)="close()">
      <i class="fa-solid fa-close"></i>
    </div>
  </div>

  <mat-divider class="my-3"></mat-divider>

  <form [formGroup]="notesForm" class="row">

    <!-- Campo Número da Nota -->
    <div class="col-md-6 mb-3">
      <span class="fw-bolder">N° da Nota</span>
      <mat-form-field appearance="outline" class="full-width">
        <input matInput formControlName="noteNumber" placeholder="Digite o número da nota" />
        <mat-hint>Informe o número da nota</mat-hint>
      </mat-form-field>
    </div>

    <!-- Campo Contrato -->
    <div class="col-md-6 mb-3">
      <span class="fw-bolder">Contrato</span>
      <mat-form-field appearance="outline" class="full-width">
        <mat-select [formControl]="contractCtrl" [compareWith]="compareContracts">
          <!-- Campo de busca para contratos -->
          <mat-option>
            <ngx-mat-select-search
              [formControl]="contractFilterCtrl"
              placeholderLabel="Buscar Contrato"
              noEntriesFoundLabel="Contrato não encontrado">
            </ngx-mat-select-search>
          </mat-option>
          <!-- Lista de contratos filtrados -->
          <mat-option *ngFor="let contract of filteredContracts$ | async" [value]="contract.id">
            {{ contract.contract_number }} - {{ contract.client?.name || 'Sem cliente' }}
          </mat-option>
        </mat-select>
        <mat-hint>Selecione o contrato associado à nota</mat-hint>
      </mat-form-field>
    </div>

    <!-- Campo Data de Recebimento -->
    <div class="col-md-6 mb-3">
      <span class="fw-bolder">Data de Recebimento</span>
      <mat-form-field appearance="outline" class="full-width">
        <input matInput [matDatepicker]="receivedDatePicker" formControlName="receivedDate" placeholder="Escolha a data" />
        <mat-datepicker-toggle matSuffix [for]="receivedDatePicker"></mat-datepicker-toggle>
        <mat-datepicker #receivedDatePicker></mat-datepicker>
        <mat-hint>Selecione a data de recebimento</mat-hint>
      </mat-form-field>
    </div>

    <!-- Campo Prazo de Entrega -->
    <div class="col-md-6 mb-3">
      <span class="fw-bolder">Prazo de Entrega</span>
      <mat-form-field appearance="outline" class="full-width">
        <input matInput [matDatepicker]="deliveryDatePicker" formControlName="deliveryDeadline" placeholder="Escolha o prazo" />
        <mat-datepicker-toggle matSuffix [for]="deliveryDatePicker"></mat-datepicker-toggle>
        <mat-datepicker #deliveryDatePicker></mat-datepicker>
        <mat-hint>Informe a data de prazo de entrega</mat-hint>
      </mat-form-field>
    </div>

    <!-- Campo Status -->
    <div class="col-md-12 mb-3">
      <span class="fw-bolder">Status</span>
      <mat-form-field appearance="outline" class="full-width">
        <mat-select formControlName="status" [compareWith]="compareStatus">
          <!-- Campo para busca de Status -->
          <mat-option>
            <ngx-mat-select-search
              [formControl]="statusFilterCtrl"
              placeholderLabel="Buscar Status"
              noEntriesFoundLabel="Status não encontrado">
            </ngx-mat-select-search>
          </mat-option>
          <!-- Lista de Status filtrados -->
          <mat-option *ngFor="let status of filteredStatus$ | async" [value]="status.id">
            {{ status.name }}
          </mat-option>
        </mat-select>
        <mat-hint>Selecione o status da nota de empenho</mat-hint>
      </mat-form-field>
    </div>

    <!-- Campo Observações -->
    <div class="col-md-12 mb-3">
      <span class="fw-bolder">Observações</span>
      <mat-form-field appearance="outline" class="full-width">
        <textarea matInput formControlName="observations" placeholder="Digite suas observações"></textarea>
        <mat-hint>Informe observações adicionais, se necessário</mat-hint>
      </mat-form-field>
    </div>

    <!-- Campo Produtos -->
    <div class="col-md-12 mb-3">
      <span class="fw-bolder">Produtos</span>
      <div formArrayName="products" class="mt-3">
        <div *ngFor="let product of products.controls; let i = index" [formGroupName]="i" class="product-card mb-3">
          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h5># {{ i + 1 }} {{ (product.get('productName')?.value.name || '').slice(0, 20) }}{{ (product.get('productName')?.value.name || '').length > 20 ? '...' : '' }}</h5>
              <!-- Botão Remover -->
              <div class="card-notes-container-remove">
                <button mat-icon-button (click)="removeProduct(i)" aria-label="Remover Produto" class="remove-product-button">
                  <i class="fas fa-trash-alt"></i>
                </button>
              </div>
            </div>
            <div class="card-body">
              <div class="card-notes-container">
                <div class="card-notes-container-body">
                  <!-- Campo Produto -->
                  <div class="card-notes-container-produto w-100">
                    <span class="fw-bolder">Produto</span>
                    <mat-form-field appearance="outline" class="full-width">
                      <mat-select formControlName="productName" (selectionChange)="onProductChange($event, i)" required>
                        <mat-option>
                          <ngx-mat-select-search
                            [formControl]="productFilterCtrl"
                            placeholderLabel="Buscar Produto"
                            noEntriesFoundLabel="Produto não encontrado">
                          </ngx-mat-select-search>
                        </mat-option>
                        <mat-option *ngFor="let prod of filteredProducts$ | async" [value]="prod">
                          {{ prod.name }}
                        </mat-option>
                      </mat-select>
                      <mat-error *ngIf="product.get('productName')?.hasError('required')">
                        Campo obrigatório
                      </mat-error>
                      <mat-hint>Selecione o produto desejado</mat-hint>
                    </mat-form-field>
                  </div>

                  <!-- Campo Quantidade -->
                  <div class="card-notes-container-quantidade">
                    <span class="fw-bolder">Quantidade</span>
                    <div class="quantity-container">
                      <button type="button" (click)="decrementQuantity(i)">-</button>
                      <input
                        type="number"
                        formControlName="quantity"
                        placeholder="Quantidade"
                        required
                        min="1"
                        (input)="updateTotal(i)" />
                      <button type="button" (click)="incrementQuantity(i)">+</button>
                    </div>
                  </div>

                </div>

                <!-- Campo Preço Sugerido -->
                <div class="card-notes-container-footer">
                  <span class="fw-bolder">Preço Sugerido</span>
                  <mat-form-field appearance="outline" class="full-width">
                    <input
                      readonly
                      matInput
                      type="text"
                      formControlName="sale_price"
                      placeholder="Preço Unitário"
                      required
                      [mask]="'separator.2'"
                      prefix="R$ "
                      [dropSpecialCharacters]="false" />
                    <mat-hint>Preço sugerido pelo sistema</mat-hint>
                  </mat-form-field>
                </div>

                <!-- Campo Preço Atual -->
                <div class="card-notes-container-footer">
                  <span class="fw-bolder">Preço Atual</span>
                  <mat-form-field appearance="outline" class="full-width">
                    <input
                      matInput
                      type="text"
                      formControlName="adjustedPrice"
                      placeholder="Preço Ajustado"
                      [mask]="'separator.2'"
                      prefix="R$ "
                      [dropSpecialCharacters]="false"
                      (input)="validateAdjustedPrice(i)" />
                    <mat-hint *ngIf="toNumber(product.get('adjustedPrice')?.value) < toNumber(product.get('sale_price')?.value)">
                      ⚠️ O preço ajustado está menor que o preço unitário.
                    </mat-hint>
                  </mat-form-field>
                </div>

                <h3 class="fw-bolder">Total: R$ {{ getTotal(i) }}</h3>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Mensagem de erro para produtos -->
      <span *ngIf="notesForm.get('products')?.errors?.required" class="error">
        É necessário adicionar pelo menos um produto.
      </span>
      <div class="mt-3">
        <button mat-raised-button color="primary" (click)="addProduct()" class="add-product-button">
          Adicionar Produto
        </button>
      </div>
    </div>

  </form>
</mat-dialog-content>

<mat-dialog-actions>
  <div class="container">
    <div id="actionsDialog" class="flex-sm-row flex-column">
      <div *ngIf="loading" class="me-auto me-sm-0 mb-sm-0 mb-2 loading">
        <mat-spinner></mat-spinner>
      </div>
      <div id="buttonsDialog" class="flex-sm-row flex-column">
        <div class="col-auto">
          <button matRipple id="cancel" class="button cancel" (click)="close()">Cancelar</button>
        </div>
        <div class="col-auto">
          <button matRipple id="submit" class="button yellow" (click)="submit()">
            {{ isNew ? 'Criar' : 'Salvar' }}
          </button>
        </div>
      </div>
    </div>
  </div>
</mat-dialog-actions>
